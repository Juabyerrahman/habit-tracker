# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=68c5e1f91e6a175755df63b8954b93ccb0fb9ee440e42f164d34f92f73719dcc

DATABASE_URL=sqlite:///habit_tracker.db
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Refresh-token cookie. In production: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

RATELIMIT_STORAGE_URI=memory://

# ---- Google sign-in (optional; leave GOOGLE_CLIENT_ID empty to disable) ----
GOOGLE_CLIENT_ID=your-google-client-id
# Server-side secret. Backend only. NEVER put it in the frontend, in git, or in chat.
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorised redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Where the browser lands after Google login (React app)
GOOGLE_SUCCESS_URL=http://localhost:5173/auth/callback
GOOGLE_ERROR_URL=http://localhost:5173/login
# Serves /dev/auth-test, a plain HTML page for testing login without the React app
ENABLE_DEV_TOOLS=true
