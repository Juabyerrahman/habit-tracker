# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development



DATABASE_URL=sqlite:///habit_tracker.db
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Refresh-token cookie. In production: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

RATELIMIT_STORAGE_URI=memory://

JWT_SECRET_KEY=replace-with-your-own-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_SUCCESS_URL=http://localhost:5173/auth/callback
GOOGLE_ERROR_URL=http://localhost:5173/login
ENABLE_DEV_TOOLS=true
